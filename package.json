{
  "name": "bizfind",
  "version": "1.0.0",
  "description": "Local business directory software system",
  "main": "backend/app.js",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "concurrently \"npm run dev-backend\" \"npm run dev-frontend\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "concurrently \"npm run start-backend\" \"npm run start-frontend\"",
    "start-backend": "node backend/app.js",
    "start-frontend": "nuxt start frontend",
    "pm2": "pm2 start npm --name 'BizFind' -- start"
  },
  "dependencies": {
    "@nuxt/content": "^2.13.2",
    "@nuxt/eslint": "^0.3.12",
    "@nuxt/image": "^1.4.0",
    "@nuxt/ui": "^2.15.0",
    "@nuxtjs/cloudinary": "^2.7.2",
    "@nuxtjs/pwa": "^3.3.5",
    "axios": "^0.21.1",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^5.12.3",
    "nitropack": "^2.10.4",
    "nuxt": "^3.11.1",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "vuelidate": "^0.7.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@nuxtjs/tailwindcss": "^6.12.1",
    "concurrently": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-nuxt": "^2.0.0",
    "eslint-plugin-vue": "^7.20.0",
    "nodemon": "^2.0.7",
    "pm2": "^5.3.1"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "author": "BizarreEmpire",
  "license": "MIT"
}
