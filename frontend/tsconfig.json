{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "types": ["@nuxt/schema", "@types/node"],

    "paths": {
      "~/*": ["./*"],     // ✅ For Nuxt aliasing
      "@/*": ["./*"]
    },

    "moduleResolution": "bundler",   // ✅ Good for Vite + ESM
    "target": "ESNext",
    "module": "ESNext",
    "jsx": "preserve",

    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,

    "noEmit": true,                // ✅ For type-checking only
    "baseUrl": ".",                // ✅ Required for path aliases
    "lib": ["ESNext", "DOM", "DOM.Iterable"]  // ✅ Full browser + async support
  },

  "include": [
    ".nuxt/nuxt.d.ts",      // ✅ Nuxt types
    "types/**/*.d.ts",      // ✅ Custom types
    "**/*",                 // ✅ All source files
    "shims-vue.d.ts"
  ],

  "exclude": [
    "node_modules"
  ]
}
